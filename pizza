<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Піцерія Легенда & Дрова</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Leaflet CSS для карти -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  <style>
    /* Легка та оптимізована анімація фону без лагів */
    #effects-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100vw;
      height: 100vh;
      pointer-events: none;
      z-index: 1;
    }
    .content-layer {
      position: relative;
      z-index: 10;
    }
  </style>
</head>
<body class="bg-zinc-900 text-white font-sans min-h-screen relative overflow-x-hidden">

  <!-- Анімація сезонів (Canvas API) -->
  <canvas id="effects-canvas"></canvas>

  <div class="content-layer">
    <!-- Шапка сайту -->
    <header class="p-4 sm:p-6 bg-zinc-950/80 backdrop-blur-md sticky top-0 border-b border-zinc-800 flex flex-col sm:flex-row justify-between items-center gap-4">
      <h1 class="text-2xl font-bold text-amber-500 flex items-center gap-2">
        <span>🍕</span> Легенда & Дрова
      </h1>
      
      <!-- Тестовий перемикач сезонів -->
      <div class="flex gap-2 text-xs bg-zinc-900 p-1 rounded-lg border border-zinc-800">
        <button onclick="setSeason('winter')" class="px-2 py-1 hover:bg-amber-600 rounded transition">❄️ Зима</button>
        <button onclick="setSeason('spring')" class="px-2 py-1 hover:bg-amber-600 rounded transition">🌸 Весна</button>
        <button onclick="setSeason('summer')" class="px-2 py-1 hover:bg-amber-600 rounded transition">🌊 Літо</button>
        <button onclick="setSeason('autumn')" class="px-2 py-1 hover:bg-amber-600 rounded transition">🍂 Осінь</button>
      </div>
    </header>

    <!-- Головна секція (Баннер) -->
    <main class="max-w-5xl mx-auto p-4 sm:p-6 space-y-12">
